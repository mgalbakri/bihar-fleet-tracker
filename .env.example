# Server
PORT=3000
NODE_ENV=development
JWT_SECRET=generate-a-strong-secret-here

# Admin seed user
ADMIN_EMAIL=admin@bihar.com
ADMIN_PASSWORD=change-this-password

# AIS Provider (Phase 1: Datalastic)
AIS_PROVIDER=datalastic
DATALASTIC_API_KEY=your-datalastic-api-key
AIS_POLL_INTERVAL_MS=300000

# Weather (OpenWeatherMap)
OPENWEATHERMAP_API_KEY=your-owm-api-key

# ACLED (Phase 3)
ACLED_API_KEY=your-acled-key
ACLED_EMAIL=your-email

# Email / Notices (Phase 3)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=notifications@bihar.com
SMTP_PASS=your-smtp-password
NOTICE_FROM_EMAIL=operations@bihar.com

# Push Notifications (Phase 3)
VAPID_PUBLIC_KEY=generated
VAPID_PRIVATE_KEY=generated
VAPID_EMAIL=mailto:admin@bihar.com

# OSINT (Phase 3, optional)
X_API_BEARER_TOKEN=your-x-api-token
